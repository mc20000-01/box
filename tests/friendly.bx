box fr_got|$m_out
box fr_want|7
box fr_next|f_math3d
jump fcheck|m

// ---- math3d ----
premark f_math3d
box m3_op|length
box m3_v|1 2 2
umload require|math3d|f_m3_len
premark f_m3_len
box fr_name|m3d-length
box fr_got|$m3_out
box fr_want|3
box fr_next|f_m3_norm
jump fcheck|m

premark f_m3_norm
box m3_op|norm
box m3_v|3 4 0
umload require|math3d|f_m3_norm1
premark f_m3_norm1
box fr_name|m3d-norm
box fr_got|$m3_out
box fr_want|0.6 0.8 0
box fr_next|f_m3_dot
jump fcheck|m

premark f_m3_dot
box m3_op|dot
box m3_a|1 2 3
box m3_b|4 5 6
umload require|math3d|f_m3_dot1
premark f_m3_dot1
box fr_name|m3d-dot
box fr_got|$m3_out
box fr_want|32
box fr_next|f_m3_cross
jump fcheck|m

premark f_m3_cross
box m3_op|cross
box m3_a|1 0 0
box m3_b|0 1 0
umload require|math3d|f_m3_cross1
premark f_m3_cross1
box fr_name|m3d-cross
box fr_got|$m3_out
box fr_want|0 0 1
box fr_next|f_m3_dist
jump fcheck|m

premark f_m3_dist
box m3_op|dist
box m3_a|0 0 0
box m3_b|3 4 0
umload require|math3d|f_m3_dist1
premark f_m3_dist1
box fr_name|m3d-dist
box fr_got|$m3_out
box fr_want|5
box fr_next|f_m3_sub
jump fcheck|m

premark f_m3_sub
box m3_op|subv
box m3_a|3 4 0
box m3_b|1 1 1
umload require|math3d|f_m3_sub1
premark f_m3_sub1
box fr_name|m3d-sub
box fr_got|$m3_out
box fr_want|2 3 -1
box fr_next|f_m3_scale
jump fcheck|m

premark f_m3_scale
box m3_op|scalev
box m3_v|1 2 3
box m3_s|0.5
umload require|math3d|f_m3_scale1
premark f_m3_scale1
box fr_name|m3d-scale
box fr_got|$m3_out
box fr_want|0.5 1 1.5
box fr_next|f_sound
jump fcheck|m

// ---- sound ----
premark f_sound
box sn_op|arpeggio
box sn_notes|C4 E4 G4
box sn_d|0.02
umload require|sound|f_snd_arp
premark f_snd_arp
box fr_name|snd-arpeggio-count
box fr_got|$sn_out
box fr_want|3
box fr_next|f_snd_beep
jump fcheck|m

premark f_snd_beep
box sn_op|beep
umload require|sound|f_snd_beep1
premark f_snd_beep1
box fr_name|snd-beep
box fr_got|$sn_out
box fr_want|ok
box fr_next|f_snd_export
jump fcheck|m

premark f_snd_export
box sn_op|export
box sn_path|.build/friendly.wav
umload require|sound|f_snd_export1
premark f_snd_export1
box fr_name|snd-export
box fr_got|$sn_out
box fr_want|ok
box fr_next|f_snd_render
jump fcheck|m

premark f_snd_render
box sn_op|render
umload require|sound|f_snd_render1
premark f_snd_render1
str fr_n|len|$sn_out
box fr_got|1
jumpif $fr_n|>|0|f_snd_ok|m
box fr_got|0
premark f_snd_ok
box fr_name|snd-render-samples
box fr_want|1
box fr_next|f_done
jump fcheck|m

premark f_done
say friendly package tests done, failures: $fr_fail
end