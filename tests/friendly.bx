// Friendly wrapper package tests. Each test sets op/input boxes, requires the
// package (running its module inline), resumes at a mark, and asserts the
// output box. The runner needs the local ./packages/ checkout to resolve the
// packages, exactly like tests/packages.bx.
box fr_fail|0
jump f_advmath|m

premark fcheck
jumpif $fr_got|!==|$fr_want|fr_fail|m
say PASS $fr_name
jump $fr_next|m

premark fr_fail
math fr_fail|$fr_fail|1|+
say FAIL $fr_name got [$fr_got] want [$fr_want]
jump $fr_next|m

// ---- advmath ----
premark f_advmath
box m_op|double
box m_a|21
umload require|advmath|f_ad_double
premark f_ad_double
box fr_name|adv-double
box fr_got|$m_out
box fr_want|42
box fr_next|f_ad_cube
jump fcheck|m

premark f_ad_cube
box m_op|cube
box m_a|3
umload require|advmath|f_ad_cube1
premark f_ad_cube1
box fr_name|adv-cube
box fr_got|$m_out
box fr_want|27
box fr_next|f_ad_halve
jump fcheck|m

premark f_ad_halve
box m_op|halve
box m_a|27
umload require|advmath|f_ad_halve1
premark f_ad_halve1
box fr_name|adv-halve
box fr_got|$m_out
box fr_want|13
box fr_next|f_ad_pctp
jump fcheck|m

premark f_ad_pctp
box m_op|pctp
box m_a|8
box m_b|50
umload require|advmath|f_ad_pctp1
premark f_ad_pctp1
box fr_name|adv-pctp
box fr_got|$m_out
box fr_want|16
box fr_next|f_ad_even
