// UI tests: ids, frames, docking, layouts, easing, and tween continuity.
//
// Every animation step uses a fixed delta rather than a wall-clock frame, so
// these results come out the same on a fast machine and a slow one. That is
// the reason `ui frame step` sits next to the real clock.

// Rendering needs a framebuffer, so the gfx library comes along for the tests.
// This has to run before the first jump, which is the program entry point.
lib load|gfx
high.gfx.fbsize|200|120

box ui_fail|0
// bounds used by the wave-driver range check
box ui_lo10|10
box ui_hi30|30
jump ui_first|m

premark uicheck
jumpif $ui_got|!==|$ui_want|ui_fail|m
say PASS $ui_name
jump $ui_next|m

premark ui_fail
math ui_fail|$ui_fail|1|+
say FAIL $ui_name got [$ui_got] want [$ui_want]
jump $ui_next|m

premark ui_first

// ------------------------------------------------------------------ ids
ui|init
ui.new|root|frame
ui.set|root|w|400
ui.set|root|h|300
ui.new|a|pane|root
ui.new|b|pane|root
ui.get|a|kind|ka
box ui_name|pane kind reads back
box ui_got|$ka
box ui_want|pane
box ui_next|ui_dupid
jump uicheck|m

// The same id is the same object, so a second create must not add one.
premark ui_dupid
ui.new|a|pane|root
ui.get|a|kind|ka
box ui_name|duplicate id is refused
box ui_got|$ka
box ui_want|pane
box ui_next|ui_dock
jump uicheck|m

// --------------------------------------------------------------- docking
premark ui_dock
ui.set|a|dock|left
ui.set|a|w|100
ui.set|b|dock|right
ui.set|b|w|100
ui.dock|a
ui.get|a|x|ax
box ui_name|left dock sits at x=0
box ui_got|$ax
box ui_want|0
box ui_next|ui_dockright
jump uicheck|m

premark ui_dockright
say [AT ui_dockright]
ui.dock|b
ui.get|b|x|bx
box ui_name|right dock sits at the right edge
box ui_got|$bx
box ui_want|300
box ui_next|ui_fill
jump uicheck|m

premark ui_fill
say [AT ui_fill]
ui.new|c|pane|root
ui.set|c|dock|fill
ui.dock|c
ui.get|c|w|cw
box ui_name|fill dock takes the whole frame
box ui_got|$cw
box ui_want|400
box ui_next|ui_tween
jump uicheck|m

// --------------------------------------------------------------- tweens
premark ui_tween
say [AT ui_tween]
ui.tween|sl|a|x|0|-100|0.4|linear
ui.frame|step|0.2
ui.get|a|x|ax
box ui_name|linear tween halfway
box ui_got|$ax
box ui_want|-50
box ui_next|ui_retarget
jump uicheck|m

// Same id means the same tween object, so retargeting continues from the
// current value instead of snapping back to the old start.
premark ui_retarget
ui.tween|sl|to|-40
ui.frame|step|0.4
ui.get|a|x|ax
box ui_name|retarget lands on the new value
box ui_got|$ax
box ui_want|-40
box ui_next|ui_cancel
jump uicheck|m

premark ui_cancel
ui.get|a|x|before_cancel
ui.tween|sl|cancel
ui.frame|step|0.2
ui.get|a|x|after_cancel
box ui_name|cancelled tween stops moving
box ui_got|$after_cancel
box ui_want|$before_cancel
box ui_next|ui_ease
jump uicheck|m

// --------------------------------------------------------------- easing
premark ui_ease
ui.tweenfn.set|swift|0.4 0 0.2 1
ui.ease|swift|0.5|half
box ui_name|cubic bezier is defined
box ui_got|$half
jumpif $half|!==|0|uicheck
box ui_got|defined
box ui_want|defined
box ui_next|ui_mxb
jump uicheck|m

premark ui_mxb
ui.tweenfn.set|ramp|y=mx+b 1 0
ui.ease|ramp|0.5|half
box ui_name|y=mx+b evaluates as linear
box ui_got|$half
box ui_want|0.5
box ui_next|ui_linear
jump uicheck|m

premark ui_linear
ui.ease|linear|0.25|quarter
box ui_name|linear easing is the identity
box ui_got|$quarter
box ui_want|0.25
box ui_next|ui_land
jump uicheck|m

// Spring overshoots on the way, but must still land exactly on the target.
premark ui_land
ui.new|springbox|pane
ui.tween|land|springbox|w|0|300|0.3|spring
ui.frame|step|0.5
ui.get|springbox|w|sbw
box ui_name|spring tween lands on target
box ui_got|$sbw
box ui_want|300
box ui_next|ui_layout
jump uicheck|m

// --------------------------------------------------------------- layout
premark ui_layout
ui.new|lay|frame
ui.set|lay|w|100
ui.set|lay|h|50
ui.set|lay|gap|10
ui.set|lay|layout|row
ui.new|lay1|pane|lay
ui.new|lay2|pane|lay
ui.set|lay1|w|20
ui.set|lay2|w|30
ui.layout|lay
ui.get|lay2|x|l2x
box ui_name|row layout offsets by width plus gap
box ui_got|$l2x
box ui_want|30
box ui_next|ui_center
jump uicheck|m

premark ui_center
ui.set|lay|justify|center
ui.layout|lay
ui.get|lay1|x|l1x
box ui_name|center justify shifts the row
box ui_got|$l1x
box ui_want|20
box ui_next|ui_custom
jump uicheck|m

// ------------------------------------------------------------- custom
// An unknown kind is still accepted, as a config object: a bag of values that
// can be set and tuned like any built-in element.
premark ui_custom
ui.new|theme|mytheme
ui.get|theme|kind|tk
box ui_name|custom kind is accepted
box ui_got|$tk
box ui_want|custom
box ui_next|ui_close
jump uicheck|m

premark ui_close
ui.close|b
ui.get|root|children|nc
box ui_name|closing a pane detaches it from its frame
box ui_got|$nc
box ui_want|2
box ui_next|ui_render
jump uicheck|m

// --- rendering -----------------------------------------------------------
premark ui_render
ui.init
ui.new|win|frame
ui.set|win|x|0
ui.set|win|y|0
ui.set|win|w|200
ui.set|win|h|120
ui.new|btn|button|win
ui.set|btn|x|20
ui.set|btn|y|40
ui.set|btn|w|80
ui.set|btn|h|24
ui.set|btn|text|Go
ui.render|ui_count
box ui_name|ui render reports how many elements it drew
box ui_got|$ui_count
box ui_want|2
box ui_next|ui_render_panel
jump uicheck|m

premark ui_render_panel
ui.render
high.gfx.pixel|ui_px|150|100
high.gfx.colorhex|ui_hex|$ui_px
box ui_name|the frame fills its own rect
box ui_got|$ui_hex
box ui_want|#131a22
box ui_next|ui_render_text
jump uicheck|m

premark ui_render_text
high.gfx.pixel|ui_px|30|50
high.gfx.colorhex|ui_hex|$ui_px
box ui_name|a button paints its own fill
box ui_got|$ui_hex
box ui_want|#2a8d81
box ui_next|ui_render_press
jump uicheck|m

// Hover and press each change the fill, which is the whole point of a
// stateful button. The hexes are the site palette's #2a8d81 lerped toward
// #0b0f14 (pressed) and toward #4fd6c4 (hovered).
premark ui_render_press
ui.press|btn|1
ui.render
high.gfx.pixel|ui_px|30|50
high.gfx.colorhex|ui_hex2|$ui_px
box ui_name|a pressed button draws darker
box ui_got|$ui_hex2
box ui_want|#1e5d58
box ui_next|ui_render_hover
jump uicheck|m

premark ui_render_hover
ui.press|btn|0
ui.hit|30|50|ui_hovered
ui.render
high.gfx.pixel|ui_px|30|50
high.gfx.colorhex|ui_hex3|$ui_px
box ui_name|hovering a button lightens it
box ui_got|$ui_hex3
box ui_want|#329e90
box ui_next|ui_render_hit
jump uicheck|m

premark ui_render_hit
ui.hit|30|50|ui_under
box ui_name|a hit test finds the button, not the frame under it
box ui_got|$ui_under
box ui_want|btn
box ui_next|ui_render_hit_out
jump uicheck|m

premark ui_render_hit_out
ui.hit|190|110|ui_under
box ui_name|a hit outside every child finds the frame
box ui_got|$ui_under
box ui_want|win
box ui_next|ui_render_ppm
jump uicheck|m

premark ui_render_ppm
ui.render|ppm|.build/ui-render.ppm|ui_ppm_ok
box ui_name|ui render writes a PPM
box ui_got|$ui_ppm_ok
box ui_want|1
box ui_next|ui_render_ppm_done
jump uicheck|m

// ------------------------------------------------- math-driven properties
// The point of this section: a property is a number that something else is
// allowed to compute. ui frame step evaluates the drivers before layout, so
// the value read back below is the value the renderer used.

premark ui_render_ppm_done
ui.new|glow|pane|win
ui.set|glow|w|60
ui.set|glow|h|40

// A linear function of the clock drives y from 0 to 40 over one second.
ui.mathfn.set|slide|mxb|40|0
ui.drive|glow|y|fn|slide|0|0|1|40
ui.frame|step|1.0|ui_ppm_ok2
ui.get|glow|y|gy
box ui_name|a mathfn driver moved y over the frame window
box ui_got|$gy
box ui_want|40
box ui_next|ui_wave
jump uicheck|m

premark ui_wave
// A wave driver oscillates; lo and hi bound it. Sampling at t=0 of a sin
// defined with zero phase starts at its offset, which for sin amp=1 is 0.
ui.new|pulse|pane|win
ui.set|pulse|w|20
ui.set|pulse|h|20
ui.mathfn.set|breathe|sin|1|1|0|0
ui.drive|pulse|h|wave|breathe|10|30
ui.frame|step|1.0|ui_wave_ok
ui.get|pulse|h|ph
box ui_name|a wave driver keeps h inside its lo..hi range
jumpif $ph|<|$ui_lo10|ui_wave_bad|m
jumpif $ph|>|$ui_hi30|ui_wave_bad|m
box ui_got|1
box ui_want|1
box ui_next|ui_mirror
jump uicheck|m

premark ui_wave_bad
box ui_name|a wave driver keeps h inside its lo..hi range
box ui_got|$ph
box ui_want|10 to 30
box ui_next|ui_wave_bad2
jump uicheck|m

premark ui_wave_bad2
// fold back into range so the harness moves on
box ui_next|ui_mirror
jump uicheck|m

premark ui_mirror
// A mirror driver reads one element's property and writes it to another,
// through the same field reader that ui get uses.
ui.new|src|pane|win
ui.set|src|w|33
ui.new|echo|custom
ui.drive|echo|w|mirror|src|w
ui.frame|step|1.0|ui_mirror_ok
ui.get|echo|w|ew
box ui_name|a mirror driver copies w through the shared field reader
box ui_got|$ew
box ui_want|33
box ui_next|ui_tex
jump uicheck|m

premark ui_tex
// A texture replaces the material fill. This gets a frame of its own at the
// top of the z order, because everything else in the window is still drawn
// and would otherwise cover the corner being sampled.
ui.new|texwin|frame
ui.set|texwin|z|200
ui.set|texwin|x|0
ui.set|texwin|y|0
ui.set|texwin|w|200
ui.set|texwin|h|120
ui.new|texel|pane|texwin
ui.set|texel|dock|none
ui.set|texel|x|0
ui.set|texel|y|0
ui.set|texel|w|32
ui.set|texel|h|32
ui.texture|texel|checker|8|#ff0000ff|#00ff00ff
ui.render|ui_tex_ok
// One pixel in each half of the first row of cells: cell (0,0) is the first
// colour and cell (1,0) the second, so a pattern that did not run per pixel
// cannot produce this.
high.gfx.pixel|px_a|1|1
high.gfx.pixel|px_b|9|1
box ui_name|a checker texture puts both pattern colours in the tile
jumpif $px_a|!==|0xff0000ff|ui_tex_bad|m
jumpif $px_b|!==|0x00ff00ff|ui_tex_bad|m
box ui_got|1
box ui_want|1
box ui_next|ui_tex_grad
jump uicheck|m

premark ui_tex_bad
box ui_name|a checker texture puts both pattern colours in the tile
box ui_got|$px_a/$px_b
box ui_want|0xff0000ff/0x00ff00ff
box ui_next|ui_tex_grad
jump uicheck|m

premark ui_tex_grad
// A vertical gradient runs from the first colour to the second down the
// element, which is the same function the drivers use, sampled per pixel.
ui.set|texel|w|32
ui.set|texel|h|32
ui.texture|texel|gradv|#000000ff|#ffffffff
ui.render|ui_tex_ok2
high.gfx.pixel|px_top|0|0
high.gfx.pixel|px_bot|0|31
box ui_name|a gradient runs first colour at the top to second at the bottom
jumpif $px_top|!==|0x000000ff|ui_tex_grad_bad|m
jumpif $px_bot|!==|0xffffffff|ui_tex_grad_bad|m
box ui_got|1
box ui_want|1
box ui_next|ui_tex_anim
jump uicheck|m

premark ui_tex_grad_bad
box ui_name|a gradient runs first colour at the top to second at the bottom
box ui_got|$px_top/$px_bot
box ui_want|0x000000ff/0xffffffff
box ui_next|ui_tex_anim
jump uicheck|m

premark ui_tex_anim
// A pattern animated by the clock: stripes have a speed parameter, so two
// frames a quarter period apart must differ at the same pixel. Nothing about
// the geometry changed between them, which is the whole claim.
// amp|freq|speed: a sine across x, drifting with the clock. Unlike stripes
// this is continuous in time, so any two frames at different times differ
// somewhere, which is what makes it a good check that time reaches the
// per-pixel function at all.
ui.texture|texel|wave|1|20|2|#204060ff|#e0e0e0ff
ui.frame|step|0.25
ui.render|ui_tex_ok3
high.gfx.pixel|px_t0|2|6
ui.frame|step|0.25
ui.render|ui_tex_ok4
high.gfx.pixel|px_t1|2|6
box ui_name|a time-parameterised texture changes between frames
jumpif $px_t0|===|$px_t1|ui_tex_anim_bad|m
box ui_got|1
box ui_want|1
box ui_next|ui_tex_end
jump uicheck|m

premark ui_tex_anim_bad
box ui_name|a time-parameterised texture changes between frames
box ui_got|$px_t0/$px_t1
box ui_want|different
box ui_next|ui_tex_end
jump uicheck|m

premark ui_tex_end
jump $ui_after_tex|m

premark ui_after_tex

premark ui_last
say ---
say ui tests done, failures: $ui_fail
end
