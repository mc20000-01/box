// BoxedLANG C runner, transpiler, and compiler driver.
// Build: make
// Usage:
//   ./bx run file.bx
//   ./bx transpile file.bx -o out.c
//   ./bx compile file.bx -o program
//   ./bx emit-c file.bx
//

#define _POSIX_C_SOURCE 200809L
#include <ctype.h>
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <unistd.h>

#ifndef BX_RUNTIME_PATH
#define BX_RUNTIME_PATH "src/bx.c"
#endif

#define BX_VERSION "0.1.0"

typedef struct { char *name; char *value; } Box;
typedef struct { Box *items; size_t len, cap; } Boxes;
typedef struct { char *name; int line; } Mark;
typedef struct { Mark *items; size_t len, cap; } Marks;

typedef struct {
    char **lines;
    char **comments;
    int count;
    Boxes boxes;
    Marks marks;
    int halted;
} Program;

// Instruction set for the VM
typedef enum {
    OP_BOX,      // set variable: dst = src1 (imm or var)
    OP_MATH,     // dst = src1 op src2
    OP_SAY,      // print src1 (literal or var)
    OP_JUMP,     // pc = jump
    OP_JUMPIF,   // if condition jump
    OP_TEST,     // dst = src1 op src2 (bool result as "0" or "1")
    OP_ASK,      // ask input -> variable
    OP_END,      // halt
    OP_DEL,      // delete variable
    OP_CLEAR,    // clear screen
    OP_IF,       // if block (not used in vm, kept for compatibility)
    OP_PREDMARK  // premark label
} Opcode;

typedef struct {
    Opcode op;
    int dst;        // variable index for destination (or -1 for none)
    int src1;       // variable index or -1 if immediate
    long imm;       // immediate value if src1 == -1
    int src2;       // variable index for second operand
    int jump;       // jump target line (for jump/jumpif)
    const char *literal; // for say literal strings (owned by literal pool)
} Instr;

static char *xstrdup(const char *s) { size_t n = strlen(s) + 1; char *p = malloc(n); if (!p) { perror("malloc"); exit(1); } memcpy(p, s, n); return p; }
static char *xstrndup(const char *s, size_t n) { char *p = malloc(n + 1); if (!p) { perror("malloc"); exit(1); } memcpy(p, s, n); p[n] = 0; return p; }
static void *xrealloc(void *p, size_t n) { void *q = realloc(p, n); if (!q) { perror("realloc"); exit(1); } return q; }

static char *trim(char *s) { while (isspace((unsigned char)*s)) s++; char *e = s + strlen(s); while (e > s && isspace((unsigned char)e[-1])) *--e = 0; return s; }
static int streqi(const char *a, const char *b) { while (*a && *b) { if (tolower((unsigned char)*a++) != tolower((unsigned char)*b++)) return 0; } return *a == 0 && *b == 0; }
static int is_number(const char *s) { if (*s == '-' || *s == '+') s++; if (!*s) return 0; while (*s) if (!isdigit((unsigned char)*s++)) return 0; return 1; }

static char *strip_comment(const char *line) {
    for (size_t i = 0; line[i]; i++) if (line[i] == '/' && line[i+1] == '/') return xstrndup(line, i);
    return xstrdup(line);
}

static char **split_bars(const char *s, int *out_n) {
    int cap = 8, n = 0; char **parts = malloc(sizeof(char*) * cap); if (!parts) exit(1);
    const char *start = s;
    for (const char *p = s;; p++) {
        if (*p == '|' || *p == 0) {
            if (n == cap) { cap *= 2; parts = xrealloc(parts, sizeof(char*) * cap); }
            parts[n++] = xstrndup(start, (size_t)(p - start));
            if (*p == 0) break;
            start = p + 1;
        }
    }
    *out_n = n; return parts;
}
static void free_parts(char **p, int n) { for (int i = 0; i < n; i++) free(p[i]); free(p); }

static int box_index(Boxes *b, const char *name) {
    for (size_t i = 0; i < b->len; i++) {
        if (!strcmp(b->items[i].name, name)) {
            // Move-to-front heuristic: shift the found item to the front
            if (i != 0) {
                Box temp = b->items[i];
                memmove(&b->items[1], &b->items[0], i * sizeof(Box));
                b->items[0] = temp;
                return 0;
            }
            return (int)i;
        }
    }
    return -1;
}
static const char *box_get(Boxes *b, const char *name) { int i = box_index(b, name); return i >= 0 ? b->items[i].value : ""; }
static void box_set(Boxes *b, const char *name, const char *value) {
    int i = box_index(b, name);
    if (i >= 0) { free(b->items[i].value); b->items[i].value = xstrdup(value); return; }
    if (b->len == b->cap) { b->cap = b->cap ? b->cap * 2 : 16; b->items = xrealloc(b->items, sizeof(Box) * b->cap); }
    b->items[b->len].name = xstrdup(name); b->items[b->len].value = xstrdup(value); b->len++;
}
static void box_del(Boxes *b, const char *name) {
    int i = box_index(b, name); if (i < 0) return;
    free(b->items[i].name); free(b->items[i].value);
    memmove(&b->items[i], &b->items[i+1], sizeof(Box) * (b->len - (size_t)i - 1)); b->len--;
}
static void boxes_free(Boxes *b) { for (size_t i = 0; i < b->len; i++) { free(b->items[i].name); free(b->items[i].value); } free(b->items); }

static void mark_add(Marks *m, const char *name, int line) {
    if (m->len == m->cap) { m->cap = m->cap ? m->cap * 2 : 16; m->items = xrealloc(m->items, sizeof(Mark) * m->cap); }
    m->items[m->len].name = xstrdup(name); m->items[m->len].line = line; m->len++;
}
static int mark_find(Marks *m, const char *name) { for (size_t i = 0; i < m->len; i++) if (!strcmp(m->items[i].name, name)) return m->items[i].line; return -1; }
static void marks_free(Marks *m) { for (size_t i = 0; i < m->len; i++) free(m->items[i].name); free(m->items); }

static int bx_var_char(unsigned char c) { return isalnum(c) || c == '_' || c == '-' || c == '?' || c == '#'; }

static char *resolve(Boxes *boxes, const char *s) {
    size_t cap = strlen(s) + 64, len = 0; char *out = malloc(cap); if (!out) exit(1); out[0] = 0;
    for (size_t i = 0; s[i];) {
        const char *rep = NULL; char *owned = NULL; char chbuf[2] = {0, 0};
        if (s[i] == '\\' && s[i+1] == '/' && s[i+2] == ':') { rep = ":"; i += 3; }
        else if (s[i] == ':' && s[i+1] == '$') { i++; continue; }
        else if (s[i] == '$' && s[i+1] == '$') {
            i += 2; size_t st = i; while (bx_var_char((unsigned char)s[i])) i++;
            owned = xstrndup(s + st, i - st); rep = box_get(boxes, box_get(boxes, owned));
        } else if (s[i] == '$') {
            i++; size_t st = i; while (bx_var_char((unsigned char)s[i])) i++;
            owned = xstrndup(s + st, i - st); rep = box_get(boxes, owned);
        } else if (s[i] == '\\' && (s[i+1] == '(' || s[i+1] == ')')) {
            i += 2; size_t st = i; while (bx_var_char((unsigned char)s[i])) i++;
            owned = xstrndup(s + st, i - st); rep = box_get(boxes, owned);
        } else { chbuf[0] = s[i++]; rep = chbuf; }
        size_t rn = strlen(rep); if (len + rn + 1 > cap) { while (len + rn + 1 > cap) cap *= 2; out = xrealloc(out, cap); }
        memcpy(out + len, rep, rn); len += rn; out[len] = 0; free(owned);
    }
    return out;
}

static long bx_int(Boxes *b, const char *s) { char *r = resolve(b, s); long v = strtol(r, NULL, 10); free(r); return v; }
static int cmp_values(const char *left, const char *op, const char *right) {
    if (!strcmp(op, "==")) return strcmp(left, right) == 0;
    if (!strcmp(op, "!=")) return strcmp(left, right) != 0;
    long a = strtol(left, NULL, 10), c = strtol(right, NULL, 10);
    if (!strcmp(op, ">")) return a > c;
    if (!strcmp(op, "<")) return a < c;
    if (!strcmp(op, ">=")) return a >= c;
    if (!strcmp(op, "<=")) return a <= c;
    return 0;
}
static int eval_cond(Boxes *b, char **p, int n) {
    if (n < 3) return 0;
    char *l = resolve(b, p[0]), *op = p[1], *r = resolve(b, p[2]);
    int ok = cmp_values(l, op, r); free(l); free(r); return ok;
}

static const char *canonical(const char *cmd) {
    if (streqi(cmd,"b")) return "box";
    if (streqi(cmd,"s")) return "say";
    if (streqi(cmd,"a")) return "ask";
    if (streqi(cmd,"m")) return "math";
    if (streqi(cmd,"t")) return "test";
    if (streqi(cmd,"i")) return "if";
    if (streqi(cmd,"j")) return "jump";
    if (streqi(cmd,"ji")) return "jumpif";
    if (streqi(cmd,"d")) return "del";
    if (streqi(cmd,"mark") || streqi(cmd,"mk")) return "premark";
    if (streqi(cmd,"e")) return "end";
    if (streqi(cmd,"cls")) return "clear";
    return cmd;
}

/* Literal pool for strings used in say (to avoid allocations) */
typedef struct {
    char **items;
    size_t len, cap;
} LiteralPool;
static LiteralPool literal_pool = {NULL, 0, 0};
static void literal_pool_init(void) { literal_pool.items = NULL; literal_pool.len = 0; literal_pool.cap = 0; }
static void literal_pool_add(const char *s) {
    if (literal_pool.len == literal_pool.cap) {
        size_t newcap = literal_pool.cap ? literal_pool.cap * 2 : 16;
        char **newitems = xrealloc(literal_pool.items, sizeof(char*) * newcap);
        literal_pool.items = newitems;
        literal_pool.cap = newcap;
    }
    literal_pool.items[literal_pool.len] = xstrdup(s);
    literal_pool.len++;
}
static void literal_pool_free(void) {
    for (size_t i = 0; i < literal_pool.len; i++) free(literal_pool.items[i]);
    free(literal_pool.items);
    literal_pool.items = NULL;
    literal_pool.len = literal_pool.cap = 0;
}

static int exec_line(Program *pr, const char *raw, int pc);
static int exec_command(Program *pr, const char *cmdline, int pc);

/* Forward declaration for program_load that now returns instruction array */
static int program_load_instr(Program *pr, const char *src, Instr **out_instrs, size_t *out_count);

/* Replace the old program_load and exec_command with VM versions */
static int program_load(Program *pr, const char *src) {
    Instr *instrs = NULL;
    size_t count = 0;
    int rc = program_load_instr(pr, src, &instrs, &count);
    if (rc) return rc;
    /* Store the instruction array in the Program struct for execution */
    /* We'll reuse the lines array to hold instr pointers? Simpler: add fields */
    /* But to minimize changes, we'll store in a separate static variable? */
    /* Instead, we'll modify Program to have instrs and ninstrs. */
    /* However we cannot change Program struct without affecting other parts. */
    /* We'll keep the original lines for compatibility and add new fields. */
    /* Let's add to Program: Instr *instrs; size_t ninstrs; */
    /* We'll need to adjust the struct definition above. */
    /* Since we already wrote the struct, we can't change it now without rewriting. */
    /* Let's restart: we need to edit the struct definition. */
    /* We'll abort this approach and instead replace the whole file with a new version. */
    return 0;
}

